    {
      "name": "3. Seed Orders Query, Search & Pagination",
      "item": [
        {
          "name": "3.1 List Seeded Orders (Default Page 1, limit=10)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieves first 10 orders from the 50,000 seeded dataset and stores pagination.nextCursor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test(\"Returns array of 10 orders and nextCursor\", () => {",
                  "    pm.expect(json.data).to.be.an(\"array\").with.lengthOf(10);",
                  "    pm.expect(json.pagination.hasMore).to.be.true;",
                  "    pm.expect(json.pagination.nextCursor).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"nextCursor\", json.pagination.nextCursor);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Keyset Pagination (Page 2 with cursor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?limit=10&cursor={{nextCursor}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}"
                }
              ]
            },
            "description": "Traverses to Page 2 using keyset pagination (createdAt, id tiebreaker)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test(\"Returns next 10 orders\", () => {",
                  "    pm.expect(json.data).to.be.an(\"array\").with.lengthOf(10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
