        {
          "name": "3.9 Custom Sort (totalAmount Ascending)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?sortBy=totalAmount&sortOrder=asc&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "sortBy",
                  "value": "totalAmount"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Verifies custom sorting with tiebreaker on totalAmount."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test(\"Sorted in ascending amount order\", () => {",
                  "    for (var i = 1; i < json.data.length; i++) {",
                  "        var prev = parseFloat(json.data[i-1].totalAmount);",
                  "        var curr = parseFloat(json.data[i].totalAmount);",
                  "        pm.expect(prev).to.be.at.most(curr);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
