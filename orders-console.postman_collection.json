            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates as seeded Agent User (role: MANAGER). Stores token in collection variable 'token'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test(\"Seed user role is MANAGER\", () => {",
                  "    pm.expect(json.data.user.email).to.eql(\"agent@orders.test\");",
                  "    pm.expect(json.data.user.name).to.eql(\"Agent User\");",
                  "    pm.expect(json.data.user.role).to.eql(\"MANAGER\");",
                  "    pm.expect(json.data).to.have.property(\"accessToken\");",
                  "    pm.collectionVariables.set(\"token\", json.data.accessToken);",
