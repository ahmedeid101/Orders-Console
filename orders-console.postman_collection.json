  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "1.1 Live Check (GET /api/health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Checks if the Express API process is alive. No auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Service status ok\", () => {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "    pm.expect(json.service).to.eql(\"orders-console-api\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Database Ready Check (GET /api/ready)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ready",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ready"]
            },
            "description": "Checks PostgreSQL connectivity (SELECT 1 via Prisma). No auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Database connected\", () => {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"ready\");",
                  "    pm.expect(json.database).to.eql(\"connected\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
