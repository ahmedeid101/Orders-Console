            "description": "Validates error when cursor UUID does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "var json = pm.response.json();",
                  "pm.expect(json.error.message).to.eql(\"Invalid pagination cursor\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Role-Based Scoping (Customer vs Agent)",
      "item": [
        {
          "name": "4.1 Query Orders as Customer James Smith (Scoped)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Uses customer token (james.smith0@example.test). Verifies that every returned order belongs exclusively to James Smith."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test(\"All returned orders belong to James Smith\", () => {",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    json.data.forEach(order => {",
                  "        pm.expect(order.customerEmail).to.eql(\"james.smith0@example.test\");",
                  "        pm.expect(order.customerName).to.eql(\"James Smith\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.2 Query Orders as Agent (Global Visibility)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Uses agent token. Verifies orders from multiple distinct customers across the entire database are returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test(\"Agent sees orders from multiple customers\", () => {",
                  "    var uniqueEmails = new Set(json.data.map(o => o.customerEmail));",
                  "    pm.expect(uniqueEmails.size).to.be.above(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Order Creation (Seed Products & Idempotency)",
      "item": [
        {
          "name": "5.1 Create Order with Seed Products (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{testIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Sarah Moore\",\n  \"customerEmail\": \"sarah.moore17@example.test\",\n  \"items\": [\n    {\n      \"name\": \"Mechanical Keyboard\",\n      \"qty\": 1,\n      \"unitPriceCents\": 12000\n    },\n    {\n      \"name\": \"Wireless Mouse\",\n      \"qty\": 2,\n      \"unitPriceCents\": 2999\n    },\n    {\n      \"name\": \"USB-C Hub\",\n      \"qty\": 1,\n      \"unitPriceCents\": 3500\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Creates an order using catalog products from seed.ts (Mechanical Keyboard, Wireless Mouse, USB-C Hub) and seeded customer name Sarah Moore. Total: 120.00 + 2*29.99 + 35.00 = 214.98."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"testIdempotencyKey\", \"seed-idem-\" + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "pm.test(\"Total amount calculated accurately as 214.98\", () => {",
                  "    pm.expect(json.data.totalAmount).to.eql(\"214.98\");",
                  "    pm.expect(json.data.status).to.eql(\"PENDING\");",
                  "    pm.expect(json.data.items).to.have.lengthOf(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5.2 Replay Order (Same Key + Same Body -> 201 Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{testIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Sarah Moore\",\n  \"customerEmail\": \"sarah.moore17@example.test\",\n  \"items\": [\n    {\n      \"name\": \"Mechanical Keyboard\",\n      \"qty\": 1,\n      \"unitPriceCents\": 12000\n    },\n    {\n      \"name\": \"Wireless Mouse\",\n      \"qty\": 2,\n      \"unitPriceCents\": 2999\n    },\n    {\n      \"name\": \"USB-C Hub\",\n      \"qty\": 1,\n      \"unitPriceCents\": 3500\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Retries exact same request with the same Idempotency-Key. Proves cached 201 response is returned with zero duplicated orders in PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 (Idempotent replay)\", () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "pm.expect(json.data.totalAmount).to.eql(\"214.98\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5.3 Replay Order with Conflicting Body (Negative 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{testIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Sarah Moore (TAMPERED)\",\n  \"customerEmail\": \"sarah.moore17@example.test\",\n  \"items\": [\n    {\n      \"name\": \"External SSD\",\n      \"qty\": 1,\n      \"unitPriceCents\": 8900\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Reuses testIdempotencyKey with a different payload (External SSD). Must reject with 422 Unprocessable Entity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", () => pm.response.to.have.status(422));",
                  "var json = pm.response.json();",
                  "pm.expect(json.error.message).to.include(\"already used with a different request\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5.4 Missing Idempotency-Key Header (Negative 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Sarah Moore\",\n  \"customerEmail\": \"sarah.moore17@example.test\",\n  \"items\": [\n    {\n      \"name\": \"Wireless Mouse\",\n      \"qty\": 1,\n      \"unitPriceCents\": 2999\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Omits Idempotency-Key header. Must return 400 Bad Request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "var json = pm.response.json();",
                  "pm.expect(json.error.message).to.eql(\"A valid Idempotency-Key header is required\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5.5 Invalid Body - Empty Items (Negative 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "invalid-schema-key"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Sarah Moore\",\n  \"customerEmail\": \"invalid-email-format\",\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Verifies Zod rejects empty items array and malformed email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
